# Manifest for src/components/icons/libraryIcons.h — regenerate with:
#   python3 <freeink-sdk>/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/components/icons/libraryIcons.manifest \
#     --svgdir src/components/icons/svg \
#     --sizes 16,24 --out src/components/icons/libraryIcons.h
# then clang-format -i the output.
# 16px sits inside the sort strip's band; 24px matches the row icons.
# The svgdir is local: star-filled is the Lucide star with a fill, which the
# upstream icon set does not carry.
star = star-filled
